<!DOCTYPE html>
<html lang="id">

<head>

<meta charset="UTF-8">

<title>
Testimoni Ritual
</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Poppins;
}

body{

background:
linear-gradient(
rgba(0,0,0,0.88),
rgba(0,0,0,0.92)
),

url('https://images.unsplash.com/photo-1511512578047-dfb367046420?q=80&w=1200');

background-size:cover;
background-position:center;

min-height:100vh;

padding:50px;

color:white;

}

.header{

text-align:center;

margin-bottom:50px;

}

.header h1{

font-size:65px;

color:#d4af37;

text-shadow:
0 0 25px rgba(212,175,55,0.5);

margin-bottom:15px;

}

.header p{

font-size:22px;

color:#ddd;

}

.container{

display:grid;

grid-template-columns:
repeat(auto-fit,minmax(320px,1fr));

gap:30px;

}

.card{

background:
rgba(255,255,255,0.08);

backdrop-filter:blur(10px);

border:
1px solid rgba(255,255,255,0.1);

padding:30px;

border-radius:25px;

transition:0.3s;

box-shadow:
0 0 30px rgba(0,0,0,0.4);

position:relative;

overflow:hidden;

}

.card:hover{

transform:
translateY(-10px);

box-shadow:
0 0 40px rgba(147,51,234,0.5);

}

.glow{

position:absolute;

top:-50px;
right:-50px;

width:150px;
height:150px;

background:
rgba(147,51,234,0.3);

border-radius:50%;

filter:blur(50px);

}

.nama{

font-size:28px;

font-weight:bold;

margin-bottom:10px;

color:#fff;

}

.dukun{

color:#d4af37;

font-size:18px;

margin-bottom:15px;

}

.review{

line-height:1.8;

color:#ddd;

margin-bottom:20px;

}

.rating{

font-size:24px;

color:#facc15;

}

.empty{

text-align:center;

font-size:24px;

margin-top:100px;

color:#ddd;

background:
rgba(255,255,255,0.08);

padding:40px;

border-radius:20px;

}

.buttons{

margin-top:50px;

display:flex;

gap:20px;

justify-content:center;

flex-wrap:wrap;

}

a{

padding:16px 30px;

border-radius:16px;

text-decoration:none;

font-weight:bold;

transition:0.3s;

}

.add{

background:
linear-gradient(
135deg,
#9333ea,
#6b21a8
);

color:white;

}

.home{

background:
linear-gradient(
135deg,
#d4af37,
#8b5e00
);

color:white;

}

a:hover{

transform:scale(1.05);

}

</style>

</head>

<body>

<div class="header">

<h1>
🔮 Testimoni Ritual
</h1>

<p>
Cerita para pelanggan setelah memakai jasa mistis kami ✨
</p>

</div>

<% if(testimonials.length > 0){ %>

<div class="container">

<% testimonials.forEach(data => { %>

<div class="card">

<div class="glow"></div>

<div class="nama">

👤 <%= data.client_nama %>

</div>

<div class="dukun">

🔮 Dibantu oleh:
<%= data.dukun_nama %>

</div>

<div class="review">

“<%= data.review %>”

</div>

<div class="rating">

<%= "⭐".repeat(data.rating) %>

</div>

</div>

<% }) %>

</div>

<% } else { %>

<div class="empty">

Belum ada testimoni ritual 😭

</div>

<% } %>

<div class="buttons">

<a
href="/testimonial/add"
class="add"
>

Tambah Testimoni ✨

</a>

<a
href="/home"
class="home"
>

← Kembali Home

</a>

</div>

</body>
</html>