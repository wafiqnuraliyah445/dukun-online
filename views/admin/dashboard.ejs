<!DOCTYPE html>
<html lang="id">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Dashboard Ritual Dukun</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
}

body{

background:
linear-gradient(rgba(0,0,0,.88),rgba(0,0,0,.92)),
url('https://images.unsplash.com/photo-1511512578047-dfb367046420?q=80&w=1200');

background-size:cover;
background-position:center;
background-attachment:fixed;

color:white;
min-height:100vh;
padding:40px;
}

.title{

font-size:60px;
font-weight:700;
color:#facc15;

text-shadow:
0 0 20px rgba(250,204,21,.6);

margin-bottom:40px;
}

.topbar{

display:flex;
gap:20px;
flex-wrap:wrap;
margin-bottom:40px;
}

.btn{

padding:15px 28px;
border-radius:18px;
text-decoration:none;
font-weight:600;
color:white;
transition:.3s;
display:inline-flex;
align-items:center;
gap:10px;

box-shadow:
0 0 20px rgba(0,0,0,.3);

}

.btn:hover{

transform:translateY(-5px) scale(1.03);

}

.gold{
background:linear-gradient(135deg,#facc15,#ca8a04);
}

.purple{
background:linear-gradient(135deg,#9333ea,#6b21a8);
}

.green{
background:linear-gradient(135deg,#22c55e,#15803d);
}

.red{
background:linear-gradient(135deg,#ef4444,#b91c1c);
}

.cards{

display:grid;
grid-template-columns:
repeat(auto-fit,minmax(240px,1fr));

gap:25px;
margin-bottom:50px;
}

.card{

background:
rgba(255,255,255,.08);

backdrop-filter:blur(12px);

border-radius:25px;
padding:30px;

box-shadow:
0 0 25px rgba(0,0,0,.3);

transition:.3s;
}

.card:hover{

transform:translateY(-8px);

box-shadow:
0 0 30px rgba(250,204,21,.2);

}

.card h2{

font-size:20px;
margin-bottom:15px;
color:#ddd;
}

.card .number{

font-size:42px;
font-weight:700;
color:#facc15;
}

.table-box{

background:
rgba(255,255,255,.08);

backdrop-filter:blur(12px);

border-radius:25px;
overflow:hidden;

box-shadow:
0 0 30px rgba(0,0,0,.3);

}

table{

width:100%;
border-collapse:collapse;
}

thead{

background:
linear-gradient(135deg,#facc15,#ca8a04);

}

thead th{

padding:20px;
font-size:18px;
color:black;
}

tbody tr{

border-bottom:
1px solid rgba(255,255,255,.1);

transition:.3s;
}

tbody tr:hover{

background:
rgba(255,255,255,.05);

}

tbody td{

padding:20px;
text-align:center;
color:#eee;
}

.status{

padding:8px 18px;
border-radius:999px;
font-size:14px;
font-weight:600;
display:inline-block;
}

.pending{

background:#facc15;
color:black;
}

.done{

background:#22c55e;
}

.empty{

padding:50px;
text-align:center;
font-size:20px;
color:#bbb;
}

@media(max-width:768px){

.title{
font-size:40px;
}

thead{
display:none;
}

table,
tbody,
tr,
td{
display:block;
width:100%;
}

tr{
margin-bottom:20px;
padding:20px;
}

td{
text-align:left;
padding:10px 20px;
}

}

</style>

</head>

<body>

<h1 class="title">
🔮 Dashboard Ritual Dukun
</h1>

<div class="topbar">

<a href="/services" class="btn gold">
🔮 Services
</a>

<a href="/admin/add-service" class="btn gold">
➕ Tambah Ritual
</a>

<a href="/testimonials" class="btn purple">
⭐ Testimoni
</a>

<a href="/payments" class="btn green">
💰 Payment
</a>

<a href="/logout" class="btn red">
🚪 Logout
</a>

</div>

<div class="cards">

<div class="card">
<h2>Total Booking</h2>
<div class="number">
<%= bookings.length %>
</div>
</div>

<div class="card">
<h2>Ritual Aktif</h2>
<div class="number">
13
</div>
</div>

<div class="card">
<h2>Testimoni Masuk</h2>
<div class="number">
99+
</div>
</div>

<div class="card">
<h2>Dukun Online</h2>
<div class="number">
7
</div>
</div>

</div>

<div class="table-box">

<% if(bookings.length > 0){ %>

<table>

<thead>

<tr>
<th>Nama Klien</th>
<th>Nama Dukun</th>
<th>Jasa</th>
<th>Tanggal</th>
<th>Status</th>
</tr>

</thead>

<tbody>

<% bookings.forEach(data => { %>

<tr>

<td>
<%= data.client_nama %>
</td>

<td>
<%= data.dukun_nama %>
</td>

<td>
<%= data.jasa %>
</td>

<td>
<%= data.tanggal %>
</td>

<td>

<span class="status pending">
<%= data.status %>
</span>

</td>

</tr>

<% }) %>

</tbody>

</table>

<% } else { %>

<div class="empty">
Belum ada booking ritual 😭
</div>

<% } %>

</div>

</body>
</html>