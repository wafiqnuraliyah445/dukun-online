<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tambah Booking</title>

    <style>

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family:'Poppins', sans-serif;
        }

        body{
            min-height:100vh;
            display:flex;
            justify-content:center;
            align-items:center;

            background:
            linear-gradient(rgba(0,0,0,0.78), rgba(0,0,0,0.78)),
            url('https://images.unsplash.com/photo-1518562180175-34a163b1a9a6?q=80&w=1200&auto=format&fit=crop');

            background-size:cover;
            background-position:center;
            color:white;
        }

        .container{
            width:420px;

            background:rgba(20,20,20,0.75);
            backdrop-filter:blur(8px);

            padding:35px;
            border-radius:20px;

            box-shadow:0 0 30px rgba(0,0,0,0.5);
        }

        h1{
            text-align:center;
            margin-bottom:25px;
            color:#d4af37;
            font-size:35px;
        }

        form{
            display:flex;
            flex-direction:column;
        }

        input,
        select{
            margin:10px 0;
            padding:14px;

            border:none;
            outline:none;

            border-radius:12px;

            background:rgba(255,255,255,0.08);

            color:white;
            font-size:14px;
        }

        input:focus,
        select:focus{
            border:1px solid #d4af37;
            box-shadow:0 0 10px rgba(212,175,55,0.4);
        }

        option{
            background:#1e1e1e;
            color:white;
        }

        button{
            margin-top:15px;
            padding:14px;

            border:none;
            border-radius:12px;

            background:linear-gradient(135deg,#d4af37,#8b5e00);

            color:white;
            font-weight:bold;

            cursor:pointer;

            transition:0.3s;
        }

        button:hover{
            transform:scale(1.03);
            box-shadow:0 0 15px rgba(212,175,55,0.5);
        }

    </style>

</head>
<body>

    <div class="container">

        <h1>🔮 Tambah Ritual</h1>

        <form action="/add" method="POST">

            <input
            type="text"
            name="client_nama"
            placeholder="Nama Klien"
            required>

            <select name="dukun_nama" required>

                <option value="">Pilih Dukun</option>

                <option value="Mbah Coding">Mbah Coding</option>
                <option value="Ki Debugging">Ki Debugging</option>
                <option value="Nyi Stackoverflow">Nyi Stackoverflow</option>
                <option value="Mbah Query">Mbah Query</option>

            </select>

            <select name="jasa" required>

    <option value="">
    Pilih Ritual
    </option>

    <option value="Pelet Anti Ghosting"
    <%= selectedService === 'Pelet Anti Ghosting' ? 'selected' : '' %>>
    Pelet Anti Ghosting
    </option>

    <option value="Penglaris Dagangan"
    <%= selectedService === 'Penglaris Dagangan' ? 'selected' : '' %>>
    Penglaris Dagangan
    </option>

    <option value="Santet Halus"
    <%= selectedService === 'Santet Halus' ? 'selected' : '' %>>
    Santet Halus
    </option>

    <option value="Buka Aura"
    <%= selectedService === 'Buka Aura' ? 'selected' : '' %>>
    Buka Aura
    </option>

    <option value="Pengasihan Mantan"
    <%= selectedService === 'Pengasihan Mantan' ? 'selected' : '' %>>
    Pengasihan Mantan
    </option>

</select>
            <input
            type="date"
            name="tanggal"
            required>

            <select name="status" required>

                <option value="">Pilih Status</option>

                <option value="diproses">Diproses</option>
                <option value="selesai">Selesai</option>

            </select>

            <button type="submit">
                Simpan Ritual
            </button>

        </form>

    </div>

</body>
</html>