<!DOCTYPE html>
<html lang="id">

<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0">

<title>
Layanan Dukun Online
</title>

<link
href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
}

body{

background:
linear-gradient(
rgba(0,0,0,0.82),
rgba(0,0,0,0.92)
),

url('https://images.unsplash.com/photo-1511512578047-dfb367046420?q=80&w=1200');

background-size:cover;
background-position:center;
background-attachment:fixed;

min-height:100vh;

padding:50px;

color:white;

}

.title{

text-align:center;

margin-bottom:50px;

}

.title h1{

font-size:55px;

color:#d4af37;

margin-bottom:10px;

text-shadow:
0 0 20px rgba(212,175,55,0.5);

}

.title p{

color:#ddd;

font-size:18px;

}

.container{

display:grid;

grid-template-columns:
repeat(auto-fit,minmax(320px,1fr));

gap:30px;

}

.card{

background:
rgba(255,255,255,0.08);

border:
1px solid rgba(255,255,255,0.08);

backdrop-filter:blur(10px);

padding:30px;

border-radius:24px;

transition:0.3s ease;

box-shadow:
0 10px 30px rgba(0,0,0,0.3);

position:relative;

overflow:hidden;

}

.card::before{

content:'';

position:absolute;

top:0;
left:0;

width:100%;
height:5px;

background:
linear-gradient(
90deg,
#d4af37,
#9333ea
);

}

.card:hover{

transform:
translateY(-10px);

box-shadow:
0 15px 35px rgba(212,175,55,0.2);

}

.card h2{

font-size:28px;

color:#d4af37;

margin-bottom:18px;

}

.info{

margin-bottom:12px;

color:#ddd;

line-height:1.7;

font-size:15px;

}

.label{

color:#ffffff;

font-weight:600;

}

.price{

margin-top:20px;

font-size:24px;

font-weight:bold;

color:#22c55e;

}

.empty{

padding:40px;

text-align:center;

border-radius:20px;

background:
rgba(255,255,255,0.08);

color:#ddd;

font-size:18px;

}

.back{

display:inline-block;

margin-top:50px;

padding:15px 28px;

background:
linear-gradient(
135deg,
#9333ea,
#6b21a8
);

border-radius:15px;

text-decoration:none;

color:white;

font-weight:600;

transition:0.3s;

}

.back:hover{

transform:scale(1.05);

}

@media(max-width:768px){

body{

padding:25px;

}

.title h1{

font-size:38px;

}

}

</style>

</head>

<body>

<div class="title">

<h1>
🔮 Layanan Dukun Online
</h1>

<p>
Pilih ritual terbaik sesuai kebutuhan hidupmu
</p>

</div>

<div class="container">

<% if(services && services.length > 0){ %>

    <% services.forEach(service => { %>

        <div class="card">

            <h2>
                <%= service.nama_jasa %>
            </h2>

            <div class="info">

                <span class="label">
                    👤 Dukun:
                </span>

                <%= service.nama_dukun %>

            </div>

            <div class="info">

                <span class="label">
                    📝 Deskripsi:
                </span>

                <%= service.deskripsi %>

            </div>

            <div class="price">

                Rp
                <%= service.harga_jasa %>

            </div>

        </div>

    <% }) %>

<% } else { %>

    <div class="empty">

        Belum ada layanan tersedia 🔮

    </div>

<% } %>

</div>

<a
href="/home"
class="back">

← Kembali Home

</a>

</body>
</html>