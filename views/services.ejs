<!DOCTYPE html>
<html lang="id">

<head>

<meta charset="UTF-8">

<title>
Layanan Dukun Online
</title>

<style>

*{

margin:0;
padding:0;
box-sizing:border-box;
font-family:Poppins;

}

body{

background:
linear-gradient(
rgba(0,0,0,0.8),
rgba(0,0,0,0.9)
),

url('https://images.unsplash.com/photo-1511512578047-dfb367046420?q=80&w=1200');

background-size:cover;

color:white;

padding:50px;

min-height:100vh;

}

h1{

font-size:50px;

color:#d4af37;

margin-bottom:40px;

text-shadow:
0 0 20px rgba(212,175,55,0.5);

}

.container{

display:grid;

grid-template-columns:
repeat(auto-fit,minmax(300px,1fr));

gap:30px;

}

.card{

background:
rgba(255,255,255,0.08);

backdrop-filter:blur(10px);

padding:30px;

border-radius:20px;

transition:0.3s;

box-shadow:
0 0 20px rgba(0,0,0,0.3);

}

.card:hover{

transform:
translateY(-10px);

box-shadow:
0 0 30px rgba(212,175,55,0.3);

}

.card h2{

font-size:28px;

color:#d4af37;

margin-bottom:15px;

}

.card p{

margin-bottom:10px;

color:#ddd;

}

.price{

font-size:22px;

font-weight:bold;

color:#22c55e;

margin-top:15px;

}

a{

display:inline-block;

margin-top:50px;

padding:14px 25px;

background:
linear-gradient(
135deg,
#9333ea,
#6b21a8
);

border-radius:15px;

text-decoration:none;

color:white;

font-weight:bold;

transition:0.3s;

}

a:hover{

transform:scale(1.05);

}

</style>

</head>

<body>

<h1>
🔮 Layanan Dukun Online
</h1>

<div class="container">

<% services.forEach(service => { %>

<div class="card">

<h2>
<%= service.nama_jasa %>
</h2>

<p>
👤 Dukun:
<%= service.nama_dukun %>
</p>

<p>
📝
<%= service.deskripsi %>
</p>

<div class="price">

Rp
<%= service.harga_jasa %>

</div>

</div>

<% }) %>

</div>

<a href="/home">

← Kembali Home

</a>

</body>
</html>