<!DOCTYPE html>
<html lang="id">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Layanan Dukun</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
}

body{

min-height:100vh;

padding:50px;

background:
linear-gradient(
rgba(0,0,0,.85),
rgba(0,0,0,.88)
),

url('https://images.unsplash.com/photo-1511512578047-dfb367046420?q=80&w=1200');

background-size:cover;
background-position:center;

color:white;
}

h1{

text-align:center;

font-size:65px;

color:#facc15;

margin-bottom:10px;

text-shadow:
0 0 20px rgba(250,204,21,.5);
}

.sub{

text-align:center;

color:#ddd;

font-size:22px;

margin-bottom:50px;
}

.container{

display:grid;

grid-template-columns:
repeat(auto-fit,minmax(320px,1fr));

gap:30px;
}

.card{

background:
rgba(20,20,20,.75);

border-radius:25px;

padding:30px;

backdrop-filter:blur(10px);

border:
1px solid rgba(255,255,255,.06);

transition:.3s;
}

.card:hover{

transform:
translateY(-8px)
scale(1.02);

box-shadow:
0 0 25px rgba(250,204,21,.18);
}

.title{

font-size:38px;

font-weight:700;

margin-bottom:20px;

color:#facc15;
}

.info{

font-size:18px;

line-height:1.8;

color:#e5e5e5;
}

.price{

margin-top:20px;

font-size:38px;

font-weight:bold;

color:#22c55e;
}

.back{

display:inline-block;

margin-top:50px;

padding:16px 28px;

border-radius:18px;

text-decoration:none;

font-weight:600;

background:
linear-gradient(
135deg,
#9333ea,
#6b21a8
);

color:white;

transition:.3s;
}

.back:hover{

transform:scale(1.05);
}

</style>

</head>
<body>

<h1>
🔮 Layanan Dukun Online
</h1>

<div class="sub">
Pilih ritual terbaik sesuai kebutuhan hidupmu
</div>

<div class="container">

<% services.forEach(service => { %>

<div class="card">

<div class="title">
<%= service.nama_jasa %>
</div>

<div class="info">

⏳ Durasi:
<%= service.durasi_hari %> Hari

<br><br>

⚠️ Efek Samping:
<%= service.efek_samping %>

</div>

<div class="price">

Rp <%= Number(service.harga_jasa).toLocaleString('id-ID') %>

</div>

</div>

<% }) %>

</div>

<a
href="/home"
class="back">

← Kembali Home

</a>

</body>
</html>