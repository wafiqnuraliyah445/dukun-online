<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Ritual</title>

    <style>

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family:'Poppins', sans-serif;
        }

        body{
            min-height:100vh;
            display:flex;
            justify-content:center;
            align-items:center;

            background:
            linear-gradient(rgba(0,0,0,0.78), rgba(0,0,0,0.78)),
            url('https://images.unsplash.com/photo-1518562180175-34a163b1a9a6?q=80&w=1200&auto=format&fit=crop');

            background-size:cover;
            background-position:center;

            color:white;
        }

        .container{
            width:420px;

            background:rgba(20,20,20,0.75);
            backdrop-filter:blur(8px);

            padding:35px;
            border-radius:20px;

            box-shadow:0 0 30px rgba(0,0,0,0.5);
        }

        h1{
            text-align:center;
            margin-bottom:25px;

            color:#d4af37;
            font-size:34px;

            text-shadow:0 0 10px rgba(212,175,55,0.5);
        }

        form{
            display:flex;
            flex-direction:column;
        }

        input,
        select{
            margin:10px 0;
            padding:14px;

            border:none;
            outline:none;

            border-radius:12px;

            background:rgba(255,255,255,0.08);

            color:white;
            font-size:14px;

            transition:0.3s;
        }

        input:focus,
        select:focus{
            border:1px solid #d4af37;
            box-shadow:0 0 10px rgba(212,175,55,0.4);

            background:rgba(255,255,255,0.12);
        }

        option{
            background:#1e1e1e;
            color:white;
        }

        button{
            margin-top:15px;
            padding:14px;

            border:none;
            border-radius:12px;

            background:linear-gradient(135deg,#d4af37,#8b5e00);

            color:white;
            font-size:16px;
            font-weight:bold;

            cursor:pointer;
            transition:0.3s;
        }

        button:hover{
            transform:scale(1.03);
            box-shadow:0 0 15px rgba(212,175,55,0.5);
        }

    </style>
</head>
<body>

    <div class="container">

        <h1>✏️ Edit Ritual</h1>

        <form action="/edit/<%= booking._id %>" method="POST">

            <input
            type="text"
            name="client_nama"
            value="<%= booking.client_nama %>"
            required>

            <select name="dukun_nama" required>

                <option value="Mbah Coding"
                <%= booking.dukun_nama === 'Mbah Coding' ? 'selected' : '' %>>
                Mbah Coding
                </option>

                <option value="Ki Debugging"
                <%= booking.dukun_nama === 'Ki Debugging' ? 'selected' : '' %>>
                Ki Debugging
                </option>

                <option value="Nyi Stackoverflow"
                <%= booking.dukun_nama === 'Nyi Stackoverflow' ? 'selected' : '' %>>
                Nyi Stackoverflow
                </option>

                <option value="Mbah Query"
                <%= booking.dukun_nama === 'Mbah Query' ? 'selected' : '' %>>
                Mbah Query
                </option>

            </select>

            <select name="jasa" required>

                <option value="Pelet Coding"
                <%= booking.jasa === 'Pelet Coding' ? 'selected' : '' %>>
                Pelet Coding
                </option>

                <option value="Santet Bug"
                <%= booking.jasa === 'Santet Bug' ? 'selected' : '' %>>
                Santet Bug
                </option>

                <option value="Buka Aura Coding"
                <%= booking.jasa === 'Buka Aura Coding' ? 'selected' : '' %>>
                Buka Aura Coding
                </option>

                <option value="Penglaris Database"
                <%= booking.jasa === 'Penglaris Database' ? 'selected' : '' %>>
                Penglaris Database
                </option>

            </select>

            <input
            type="date"
            name="tanggal"
            value="<%= booking.tanggal %>"
            required>

            <select name="status" required>

                <option value="diproses"
                <%= booking.status === 'diproses' ? 'selected' : '' %>>
                Diproses
                </option>

                <option value="selesai"
                <%= booking.status === 'selesai' ? 'selected' : '' %>>
                Selesai
                </option>

            </select>

            <button type="submit">
                Update Ritual
            </button>

        </form>

    </div>

</body>
</html>