<!DOCTYPE html>
<html lang="id">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Payment Ritual</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
}

body{

min-height:100vh;

display:flex;
justify-content:center;
align-items:center;

background:
linear-gradient(
rgba(0,0,0,.88),
rgba(0,0,0,.88)
),

url('https://images.unsplash.com/photo-1511512578047-dfb367046420?q=80&w=1200');

background-size:cover;
background-position:center;

padding:30px;
}

.card{

width:450px;

background:
rgba(20,20,20,.78);

backdrop-filter:blur(10px);

border-radius:28px;

padding:40px;

box-shadow:
0 0 40px rgba(0,0,0,.45);

color:white;
}

.title{

font-size:42px;
font-weight:700;

color:#facc15;

margin-bottom:10px;
}

.subtitle{

color:#bbb;

margin-bottom:35px;

line-height:1.6;
}

.info{

background:
rgba(255,255,255,.06);

padding:18px;

border-radius:18px;

margin-bottom:25px;
}

.info p{

margin:10px 0;
}

.label{

color:#999;
font-size:14px;
}

.value{

font-size:18px;
font-weight:600;
}

.price{

font-size:34px;
font-weight:700;

color:#facc15;

margin-top:10px;
}

select{

width:100%;

padding:16px;

border:none;
outline:none;

border-radius:16px;

background:
rgba(255,255,255,.08);

color:white;

font-size:15px;

margin-bottom:25px;
}

option{
background:#1e1e1e;
}

button{

width:100%;

padding:18px;

border:none;

border-radius:18px;

background:
linear-gradient(
135deg,
#facc15,
#ca8a04
);

font-size:16px;
font-weight:700;

cursor:pointer;

transition:.3s;
}

button:hover{

transform:
translateY(-4px)
scale(1.02);

}

.back{

display:block;

margin-top:20px;

text-align:center;

text-decoration:none;

color:#aaa;
}

.back:hover{
color:white;
}

</style>

</head>
<body>

<div class="card">

<div class="title">
💰 Payment Ritual
</div>

<div class="subtitle">
Selesaikan pembayaran ritual mistis pilihanmu 👁️
</div>

<form
action="/payment"
method="POST">

<input
type="hidden"
name="booking_id"
value="<%= booking._id %>">

<input
type="hidden"
name="jumlah"
value="<%= booking.harga %>">

<div class="info">

<p class="label">
Nama Client
</p>

<p class="value">
<%= booking.client_nama %>
</p>

<p class="label">
Ritual
</p>

<p class="value">
<%= booking.jasa %>
</p>

<div class="price">
Rp <%= booking.harga.toLocaleString('id-ID') %>
</div>

</div>

<select
name="metode"
required>

<option value="">
Pilih Metode Pembayaran
</option>

<option value="Transfer Bank">
🏦 Transfer Bank
</option>

<option value="Dana">
💙 Dana
</option>

<option value="OVO">
💜 OVO
</option>

<option value="Gopay">
🟢 Gopay
</option>

</select>

<button type="submit">

Bayar Sekarang

</button>

</form>

<a
href="/home"
class="back">

← Kembali

</a>

</div>

</body>
</html>