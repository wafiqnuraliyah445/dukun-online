<!DOCTYPE html>
<html lang="id">
<head>

<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width, initial-scale=1.0">

<title>Data Payment</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
}

body{

min-height:100vh;
padding:40px;

background:
linear-gradient(
rgba(0,0,0,.88),
rgba(0,0,0,.92)
),

url('https://images.unsplash.com/photo-1518562180175-34a163b1a9a6?q=80&w=1200&auto=format&fit=crop');

background-size:cover;
background-position:center;
background-attachment:fixed;

color:white;
}

.title{

font-size:55px;
font-weight:700;

color:#facc15;

margin-bottom:35px;

text-shadow:
0 0 20px rgba(250,204,21,.5);
}

.topbar{

margin-bottom:30px;
}

.btn{

display:inline-block;

padding:14px 24px;

border-radius:18px;

text-decoration:none;

font-weight:600;

color:white;

background:
linear-gradient(
135deg,
#9333ea,
#6b21a8
);

transition:.3s;
}

.btn:hover{

transform:
translateY(-4px);

}

.table-box{

background:
rgba(255,255,255,.08);

backdrop-filter:blur(10px);

border-radius:25px;

overflow:hidden;

box-shadow:
0 0 30px rgba(0,0,0,.3);
}

table{

width:100%;
border-collapse:collapse;
}

thead{

background:
linear-gradient(
135deg,
#facc15,
#ca8a04
);

}

thead th{

padding:20px;
font-size:18px;
color:black;
}

tbody tr{

border-bottom:
1px solid rgba(255,255,255,.08);

transition:.3s;
}

tbody tr:hover{

background:
rgba(255,255,255,.05);
}

tbody td{

padding:18px;
text-align:center;
color:#eee;
}

.status{

padding:8px 18px;

border-radius:999px;

font-size:14px;

font-weight:600;

display:inline-block;
}

.pending{

background:#facc15;
color:black;
}

.lunas{

background:#22c55e;
color:white;
}

.empty{

padding:60px;
text-align:center;
font-size:22px;
color:#bbb;
}

@media(max-width:768px){

.title{
font-size:38px;
}

thead{
display:none;
}

table,
tbody,
tr,
td{
display:block;
width:100%;
}

tr{
padding:20px;
margin-bottom:20px;
}

td{
text-align:left;
padding:12px 20px;
}

}

</style>

</head>

<body>

<h1 class="title">
💰 Data Payment Ritual
</h1>

<div class="topbar">

<a href="/admin/dashboard"
class="btn">

⬅ Kembali Dashboard

</a>

</div>

<div class="table-box">

<% if(payments.length > 0){ %>

<table>

<thead>

<tr>

<th>Client</th>
<th>Jumlah</th>
<th>Metode</th>
<th>Status</th>
<th>Tanggal</th>

</tr>

</thead>

<tbody>

<% payments.forEach(p => { %>

<tr>

<td>
<%= p.client_nama || '-' %>
</td>

<td>

Rp
<%= p.jumlah ? p.jumlah.toLocaleString('id-ID') : '0' %>

</td>

<td>
<%= p.metode || '-' %>
</td>

<td>

<span class="status <%= p.status === 'lunas' ? 'lunas' : 'pending' %>">

<%= p.status || 'pending' %>

</span>

</td>

<td>
<%= p.tanggal_bayar || '-' %>
</td>

</tr>

<% }) %>

</tbody>

</table>

<% } else { %>

<div class="empty">

Belum ada payment ritual 🔮

</div>

<% } %>

</div>

</body>
</html>